PORT=3000
API_PREFIX=v1

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=uztent

JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# access token lifetime in seconds
JWT_ACCESS_TTL=900
REFRESH_TOKEN_TTL_DAYS=30

# comma-separated OAuth client IDs (web, iOS, Android)
GOOGLE_CLIENT_IDS=48941119821-6j9rfs0k5e43b2i1f3qbtk97pb7kfhot.apps.googleusercontent.com

REDIS_URL=redis://localhost:6379
# MediaMTX HLS server; live = <HLS_BASE_URL>/live/<streamId>, renditions = <HLS_BASE_URL>/watch/<streamId>/<quality>
HLS_BASE_URL=http://localhost:8888
# qualities the MediaMTX transcoder publishes (watch/<streamId>/<quality>)
STREAM_RENDITIONS=1080
# encoder ingest server (OBS "Server"); the stream key is per user
STREAM_PUBLISH_URL=rtmp://localhost:1935/live
# IPs / CIDR masks allowed to call /webhooks/* (the media server)
WEBHOOK_ALLOWED_IPS=127.0.0.1,::1

# browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# MediaMTX control API (apiAddress in mediamtx.yml), polled for viewer counts
MEDIAMTX_API_URL=http://127.0.0.1:8088
VIEWERS_POLL_SECONDS=5

# minimum time between two chat messages from the same user (any stream)
CHAT_MESSAGE_INTERVAL_MS=1000
